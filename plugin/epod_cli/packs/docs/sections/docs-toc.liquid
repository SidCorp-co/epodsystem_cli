<section class="docs-toc" data-section-name="docs-toc"{% if section.settings.visible == false %} hidden{% endif %} style="background:var(--paper);{% if section.settings.padding_top != blank %}padding-top:{{ section.settings.padding_top }};{% endif %}{% if section.settings.padding_bottom != blank %}padding-bottom:{{ section.settings.padding_bottom }};{% endif %}">
  <div class="web-container dt-inner" style="max-width:1080px;margin:0 auto;">
    {% if section.settings.eyebrow != blank %}<div class="dt-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
    {% if section.settings.heading != blank %}<h2 class="dt-heading">{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.intro != blank %}<p class="dt-intro">{{ section.settings.intro }}</p>{% endif %}
    <div class="dt-grid">
      {% for block in section.blocks %}{% if block.type == 'card' %}
        <a class="dt-card{% if block.settings.featured %} dt-featured{% endif %}" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="dt-card-top">
            {% if block.settings.tag != blank %}<span class="dt-tag">{{ block.settings.tag }}</span>{% endif %}
            {% if block.settings.num != blank %}<span class="dt-num">{{ block.settings.num }}</span>{% endif %}
          </div>
          <div class="dt-card-title">{{ block.settings.title }}</div>
          {% if block.settings.desc != blank %}<p class="dt-card-desc">{{ block.settings.desc }}</p>{% endif %}
        </a>
      {% endif %}{% endfor %}
    </div>
  </div>
  <style>
    [data-section-name="docs-toc"]{padding:36px 0 52px;margin:0}
    [data-section-name="docs-toc"] .dt-inner{padding-top:0;margin-top:0}
    [data-section-name="docs-toc"] .dt-eyebrow{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--mute);font-weight:700;margin-bottom:10px}
    [data-section-name="docs-toc"] .dt-heading{font-family:var(--font-display);font-size:clamp(22px,3vw,30px);margin:0 0 10px;color:var(--ink);font-weight:700}
    [data-section-name="docs-toc"] .dt-intro{font-size:15px;line-height:1.6;color:var(--ink-2);margin:0 0 28px;max-width:70ch}
    [data-section-name="docs-toc"] .dt-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px}
    [data-section-name="docs-toc"] .dt-card{display:flex;flex-direction:column;gap:8px;background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:20px;text-decoration:none;transition:border-color .12s,box-shadow .12s,transform .12s}
    [data-section-name="docs-toc"] .dt-card:hover{border-color:var(--accent);box-shadow:0 6px 20px rgba(22,37,68,.08);transform:translateY(-2px)}
    [data-section-name="docs-toc"] .dt-featured{border-left:3px solid var(--accent);background:var(--accent-soft)}
    [data-section-name="docs-toc"] .dt-card-top{display:flex;align-items:center;justify-content:space-between}
    [data-section-name="docs-toc"] .dt-tag{font-size:10px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;background:var(--accent-soft);color:var(--accent);padding:3px 8px;border-radius:5px}
    [data-section-name="docs-toc"] .dt-num{font-family:var(--font-display);font-weight:700;font-size:15px;color:var(--mute)}
    [data-section-name="docs-toc"] .dt-card-title{font-family:var(--font-display);font-weight:700;font-size:16px;color:var(--ink);line-height:1.3}
    [data-section-name="docs-toc"] .dt-card-desc{margin:0;font-size:13.5px;line-height:1.55;color:var(--ink-2)}
    [data-section-name="docs-toc"] .dt-grid:empty::after{content:"No documents yet.";color:var(--mute);font-size:14px}
  </style>
</section>
{% schema %}{"name":"Docs TOC","category":"Docs","max_blocks":50,"settings":[
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Contents"},
  {"type":"text","id":"heading","label":"Heading","default":"Documents"},
  {"type":"textarea","id":"intro","label":"Intro","default":""},
  {"type":"header","label":"Style"},
  {"type":"checkbox","id":"visible","label":"Visible","default":true},
  {"type":"color","id":"bg_color","label":"Background color"},
  {"type":"color","id":"text_color","label":"Text color"},
  {"type":"color","id":"heading_color","label":"Heading color"},
  {"type":"text","id":"padding_top","label":"Padding top (CSS)"},
  {"type":"text","id":"padding_bottom","label":"Padding bottom (CSS)"},
  {"type":"color","id":"border_color","label":"Border color"},
  {"type":"range","id":"border_width","label":"Border width","min":0,"max":8,"step":1,"unit":"px","default":0},
  {"type":"range","id":"border_radius","label":"Border radius","min":0,"max":48,"step":1,"unit":"px","default":0}
],
"blocks":[
  {"type":"card","name":"Doc card","settings":[
    {"type":"text","id":"tag","label":"Tag","default":"DOC"},
    {"type":"text","id":"num","label":"Number","default":""},
    {"type":"text","id":"title","label":"Title","default":"Document"},
    {"type":"textarea","id":"desc","label":"Description","default":""},
    {"type":"url","id":"url","label":"Link"},
    {"type":"checkbox","id":"featured","label":"Featured","default":false}
  ]}
],
"presets":[{"name":"Docs TOC"}]}{% endschema %}
